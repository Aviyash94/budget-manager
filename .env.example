DATABASE_URL=file:./local.db
# Production only (Turso):
# DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=
AUTH_SECRET=change-me

# Needed when self-hosting with `next start` (Vercel sets this automatically):
# AUTH_TRUST_HOST=true

# Public origin, used for canonical URLs, robots.txt and the sitemap (e.g. https://your-app.vercel.app)
# NEXT_PUBLIC_SITE_URL=
