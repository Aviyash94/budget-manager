DATABASE_URL=file:./local.db
# Production only (Turso):
# DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=
AUTH_SECRET=change-me

# Needed when self-hosting with `next start` (Vercel sets this automatically):
# AUTH_TRUST_HOST=true

# Public origin, used for canonical URLs, robots.txt, the sitemap AND the links in password-reset
# emails (e.g. https://your-app.vercel.app). Required in production: reset emails fail without it.
# NEXT_PUBLIC_SITE_URL=

# Password-reset emails, sent through Resend (https://resend.com). Without these, locally the link is
# printed to the server console; in production no email is sent and the failure is logged.
# RESEND_API_KEY=
# EMAIL_FROM=Budget Manager <noreply@your-domain.example>

# Automated tests only: write emails to this folder instead of sending. Never set in production.
# EMAIL_OUTBOX_DIR=
